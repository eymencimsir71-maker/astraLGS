<style>
:root{--bg:#f7f7f5;--sf:#ffffff;--ink:#222;--mut:#777;--line:#d4d4d0;--red:#b03a2e;--ok:#2e7d4f;--hl:#fff3c4;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1e1e1e;--sf:#262626;--ink:#e6e6e6;--mut:#999;--line:#444;--red:#e57368;--ok:#6dbf8a;--hl:#4a4220}}
:root[data-theme="dark"]{--bg:#1e1e1e;--sf:#262626;--ink:#e6e6e6;--mut:#999;--line:#444;--red:#e57368;--ok:#6dbf8a;--hl:#4a4220}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{max-width:860px;margin:0 auto;padding:16px 16px 0}
header h1{margin:0;font-size:1.3em;font-weight:600}
header p{margin:2px 0 0;color:var(--mut);font-size:.9em}
nav{display:flex;gap:6px;max-width:860px;margin:12px auto 0;padding:0 16px;border-bottom:1px solid var(--line)}
nav button{background:none;border:none;border-bottom:2px solid transparent;color:var(--mut);font:inherit;padding:8px 10px;cursor:pointer}
nav button.on{color:var(--ink);border-bottom-color:var(--ink);font-weight:600}
main{max-width:860px;margin:0 auto;padding:18px 16px 48px}
.box{background:var(--sf);border:1px solid var(--line);border-radius:6px;padding:16px;margin-bottom:14px}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.mut{color:var(--mut)}
.big{font-size:2em;font-weight:600}
.btn{border:1px solid var(--ink);background:var(--ink);color:var(--bg);font:inherit;padding:8px 16px;border-radius:5px;cursor:pointer}
.btn.o{background:var(--sf);color:var(--ink)}
.btn:disabled{opacity:.35;cursor:default}
.btn.link{background:none;border:none;color:var(--mut);text-decoration:underline;padding:4px}
.list{display:grid;gap:8px}
.item{display:flex;justify-content:space-between;align-items:center;gap:10px;text-align:left;width:100%;background:var(--sf);color:var(--ink);border:1px solid var(--line);border-radius:6px;padding:12px 14px;font:inherit;cursor:pointer}
.item:hover{border-color:var(--ink)}
.bar{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin-top:8px}
.bar i{display:block;height:100%;background:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:12px}
.tag{font-size:.8em;color:var(--mut)}
.metin{border-left:3px solid var(--line);padding:6px 0 6px 14px;margin:10px 0;white-space:pre-wrap}
.opt{display:block;width:100%;text-align:left;background:var(--sf);color:var(--ink);border:1px solid var(--line);border-radius:5px;padding:9px 12px;margin-top:7px;font:inherit;cursor:pointer}
.opt:hover{border-color:var(--ink)}
.opt.sel{background:var(--hl);border-color:var(--ink)}
.opt.ok{background:var(--ok);color:#fff;border-color:var(--ok)}
.opt.no{background:var(--red);color:#fff;border-color:var(--red)}
.exp{border-top:1px solid var(--line);margin-top:10px;padding-top:8px;color:var(--mut)}
.hide{display:none}
input{font:inherit;color:var(--ink);background:var(--sf);border:1px solid var(--line);border-radius:5px;padding:9px;flex:1;min-width:0}
.done{text-decoration:line-through;color:var(--mut)}
</style>
</head>
