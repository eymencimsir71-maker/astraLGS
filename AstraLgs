/* ---------- yardımcılar ---------- */
const L="ABCD";
const $=s=>document.querySelector(s);
const st={
  get(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return d}},
  set(k,v){try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}
};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const shuf=a=>{const b=a.slice();for(let i=b.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b};
const fmt=s=>String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0");
const idsOf=(d,k)=>Q.map((q,i)=>(q[0]===d&&(k===undefined||q[6]===k))?i:-1).filter(i=>i>=0);
const konular=d=>[...new Set(Q.filter(q=>q[0]===d).map(q=>q[6]))];
const tabs=[["home","Dersler"],["exam","Deneme"],["plan","Planım"]];
let timer=null, ex=null;

$("#nav").innerHTML=tabs.map(t=>`<button data-t="${t[0]}">${t[1]}</button>`).join("");
$("#nav").onclick=e=>{const b=e.target.closest("button");if(b)go(b.dataset.t)};

function go(t,a,b){
  clearInterval(timer); ex=null; $("#v").onclick=null;
  document.querySelectorAll("nav button").forEach(x=>x.classList.toggle("on",x.dataset.t===t));
  ({home,ders,konu,exam,plan})[t](a,b);
}

const qhtml=(q,i,fb)=>`<div class="box" data-q="${i}">
  <div class="tag">${esc(q[0])} · ${esc(q[6])}</div>
  <div class="metin">${esc(q[1])}</div>
  ${q[2]?`<div><b>${esc(q[2])}</b></div>`:""}
  ${q[3].map((o,j)=>`<button class="opt" data-j="${j}">${L[j]}) ${esc(o)}</button>`).join("")}
  ${fb?'<div class="exp hide"></div>':""}
</div>`;

/* ---------- ana sayfa ---------- */
function home(){
  const sol=st.get("sol",{}), r=st.get("res",[]);
  const avg=r.length?(r.reduce((a,x)=>a+x.net,0)/r.length).toFixed(1):"—";
  const solved=Object.keys(sol).length, correct=Object.values(sol).filter(x=>x).length;
  $("#v").innerHTML=`
  <div class="box row">
    <div><div class="mut">Deneme ortalaman</div><div class="big">${avg}</div></div>
    <div class="mut" style="margin-left:auto;text-align:right">${solved}/${Q.length} soru çözüldü<br>${correct} doğru</div>
  </div>
  <div class="grid">${Object.keys(D).map(d=>{
    const ids=idsOf(d), ok=ids.filter(i=>sol[i]).length, pct=Math.round(ok/ids.length*100);
    return `<button class="item" data-d="${d}" style="display:block">
      <div class="row" style="justify-content:space-between"><b>${d}</b><span class="mut">${ids.length} soru</span></div>
      <div class="mut" style="font-size:.9em">${ok}/${ids.length} doğru</div>
      <div class="bar"><i style="width:${pct}%"></i></div></button>`;
  }).join("")}</div>
  <p style="text-align:center;margin-top:16px"><button class="btn link" id="rs">İlerlemeyi sıfırla</button></p>`;
  $("#v").onclick=e=>{
    const b=e.target.closest("[data-d]");
    if(b){go("ders",b.dataset.d);return}
    if(e.target.closest("#rs") && confirm("Tüm ilerleme ve deneme sonuçları silinsin mi?")){
      st.set("sol",{}); st.set("res",[]); home();
    }
  };
}

/* ---------- ders: konu listesi ---------- */
function ders(d){
  const sol=st.get("sol",{});
  $("#v").innerHTML=`
  <div class="row" style="margin-bottom:14px">
    <button class="btn o" id="bk">← Dersler</button>
    <h2 style="margin:0;font-size:1.2em">${d}</h2>
  </div>
  <div class="list">${konular(d).map(k=>{
    const ids=idsOf(d,k), ok=ids.filter(i=>sol[i]).length, pct=Math.round(ok/ids.length*100);
    return `<button class="item" data-k="${esc(k)}" style="display:block">
      <div class="row" style="justify-content:space-between"><span>${esc(k)}</span><span class="mut">${ids.length} soru</span></div>
      <div class="bar"><i style="width:${pct}%"></i></div></button>`;
  }).join("")}</div>`;
  $("#bk").onclick=()=>go("home");
  $("#v").onclick=e=>{
    const b=e.target.closest("[data-k]");
    if(b)go("konu",d,b.dataset.k);
  };
}

/* ---------- konu: sorular (her açılışta karışık) ---------- */
function konu(d,k){
  const ids=shuf(idsOf(d,k));
  $("#v").innerHTML=`
  <div class="row" style="margin-bottom:14px">
    <button class="btn o" id="bk">← ${esc(d)}</button>
    <span class="mut">${esc(k)} · ${ids.length} soru</span>
  </div>
  ${ids.map(i=>qhtml(Q[i],i,1)).join("")}`;
  $("#bk").onclick=()=>go("ders",d);
  answerHandler();
}

function answerHandler(){
  $("#v").onclick=e=>{
    const b=e.target.closest(".opt"), c=e.target.closest("[data-q]");
    if(!b||!c||c.dataset.done)return;
    const i=+c.dataset.q, q=Q[i], j=+b.dataset.j;
    c.dataset.done=1;
    c.querySelectorAll(".opt").forEach((x,k)=>{
      if(k===q[4])x.classList.add("ok");
      else if(k===j)x.classList.add("no");
    });
    const s=st.get("sol",{}); s[i]=j===q[4]?1:0; st.set("sol",s);
    const p=c.querySelector(".exp");
    p.classList.remove("hide");
    p.textContent=(j===q[4]?"Doğru. ":"Yanlış. Doğru cevap "+L[q[4]]+". ")+q[5];
  };
}

/* ---------- deneme ---------- */
function exam(){
  const N=Object.values(COUNT).reduce((a,b)=>a+b,0);
  $("#v").innerHTML=`<div class="box">
    <h2 style="margin-top:0;font-size:1.2em">Deneme</h2>
    <p class="mut">Her denemede sorular bankadan yeniden seçilir. ${N} soru · ${Math.round(N*SEC/60)} dakika · Net = Doğru − Yanlış ÷ 3</p>
    <button class="btn" id="go">Başla</button></div>`;
  $("#go").onclick=()=>{
    const qs=shuf(Object.keys(COUNT).flatMap(d=>shuf(idsOf(d)).slice(0,COUNT[d])));
    ex={qs:shuf(qs),a:{},i:0,t:qs.length*SEC};
    timer=setInterval(()=>{
      ex.t--;
      const s=$("#tm"); if(s)s.textContent=fmt(ex.t);
      if(ex.t<=0)finish();
    },1000);
    qview();
  };
}

function qview(){
  const n=ex.qs[ex.i], q=Q[n];
  $("#v").innerHTML=`
  <div class="row" style="margin-bottom:10px">
    <b>Soru ${ex.i+1} / ${ex.qs.length}</b>
    <b id="tm" style="margin-left:auto">${fmt(ex.t)}</b>
  </div>
  ${qhtml(q,n,0)}
  <div class="row">
    <button class="btn o" id="pv" ${ex.i?"":"disabled"}>Önceki</button>
    <button class="btn o" id="nx" ${ex.i<ex.qs.length-1?"":"disabled"}>Sonraki</button>
    <button class="btn" id="fn" style="margin-left:auto">Bitir</button>
  </div>`;
  document.querySelectorAll(".opt").forEach(b=>{
    if(ex.a[n]===+b.dataset.j)b.classList.add("sel");
    b.onclick=()=>{ex.a[n]=+b.dataset.j;qview()};
  });
  $("#pv").onclick=()=>{ex.i--;qview()};
  $("#nx").onclick=()=>{ex.i++;qview()};
  $("#fn").onclick=finish;
}

function finish(){
  clearInterval(timer);
  if(!ex)return;
  let d=0,y=0,b=0; const by={};
  ex.qs.forEach(n=>{
    const q=Q[n], s=by[q[0]]=by[q[0]]||[0,0,0];
    if(ex.a[n]===undefined){b++;s[2]++}
    else if(ex.a[n]===q[4]){d++;s[0]++}
    else{y++;s[1]++}
  });
  const net=+(d-y/3).toFixed(2), r=st.get("res",[]);
  r.push({t:Date.now(),d,y,b,net}); st.set("res",r);
  $("#v").innerHTML=`<div class="box">
    <h2 style="margin-top:0">Sonuç</h2>
    <div class="big">${net} net</div>
    <p>${d} doğru · ${y} yanlış · ${b} boş</p>
    ${Object.entries(by).map(([k,s])=>`<p class="mut" style="margin:2px 0">${k}: ${s[0]}D ${s[1]}Y ${s[2]}B → ${(s[0]-s[1]/3).toFixed(1)} net</p>`).join("")}
    <p><button class="btn" id="again">Yeni deneme</button></p></div>`;
  $("#again").onclick=()=>go("exam");
  ex=null;
}

/* ---------- planım ---------- */
function plan(){
  const p=st.get("plan",[]);
  $("#v").innerHTML=`
  <div class="row">
    <input id="pi" placeholder="Bugün ne çalışacaksın?">
    <button class="btn" id="pa">Ekle</button>
  </div>
  <div style="margin-top:16px">${p.map((x,i)=>`
    <div class="box row">
      <input type="checkbox" style="flex:none;width:20px;height:20px" data-i="${i}" ${x.d?"checked":""}>
      <span class="${x.d?"done":""}" style="flex:1">${esc(x.t)}</span>
      <button class="btn o" data-x="${i}">Sil</button>
    </div>`).join("")||'<p class="mut">Henüz görev yok.</p>'}
  </div>`;
  const add=()=>{const t=$("#pi").value.trim(); if(!t)return; p.unshift({t,d:0}); st.set("plan",p); plan()};
  $("#pa").onclick=add;
  $("#pi").onkeydown=e=>{if(e.key==="Enter")add()};
  $("#v").onclick=e=>{
    const c=e.target.closest("[data-i]"), x=e.target.closest("[data-x]");
    if(c){p[c.dataset.i].d=c.checked?1:0; st.set("plan",p); plan()}
    if(x){p.splice(x.dataset.x,1); st.set("plan",p); plan()}
  };
}

go("home");
</script>
